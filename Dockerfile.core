FROM golang:1.21 AS builder

# Set working directory
WORKDIR /app

# Install SQLite development packages
RUN apt-get update && apt-get install -y --no-install-recommends \
    gcc \
    libc6-dev \
    libsqlite3-dev \
    && rm -rf /var/lib/apt/lists/*

# Copy go.mod and go.sum
COPY go.mod go.sum ./

# Download dependencies
RUN go mod download

# Copy source code
COPY . .

# Ensure all dependencies are properly resolved
RUN go mod tidy

# Build the application with CGO enabled for SQLite support
RUN CGO_ENABLED=1 GOOS=linux go build -a -o ops-butler-core ./cmd/core

# Create final image
FROM debian:bullseye-slim

# Install required packages including SQLite and its shared libraries
RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates \
    sqlite3 \
    libsqlite3-0 \
    && rm -rf /var/lib/apt/lists/*

# Create a non-root user
RUN groupadd -g 1000 opsbutler && \
    useradd -u 1000 -g opsbutler -s /bin/sh -m opsbutler

# Create directories
RUN mkdir -p /app /data && \
    chown -R opsbutler:opsbutler /app /data

# Copy the binary from builder
COPY --from=builder --chown=opsbutler:opsbutler /app/ops-butler-core /app/

# Set working directory
WORKDIR /app

# Switch to non-root user
USER opsbutler

# Expose port
EXPOSE 8080

# Set entrypoint
ENTRYPOINT ["/app/ops-butler-core"]