FROM golang:1.21-alpine AS builder

# Set working directory
WORKDIR /app

# Copy go.mod and go.sum
COPY go.mod ./

# Download dependencies
RUN go mod download

# Copy source code
COPY . .

# Build the application
RUN CGO_ENABLED=1 GOOS=linux go build -a -o ops-butler-core ./cmd/core

# Create final image
FROM alpine:3.18

# Install required packages
RUN apk add --no-cache ca-certificates sqlite

# Create a non-root user
RUN addgroup -g 1000 opsbutler && \
    adduser -u 1000 -G opsbutler -s /bin/sh -D opsbutler

# Create directories
RUN mkdir -p /app /data && \
    chown -R opsbutler:opsbutler /app /data

# Copy the binary from builder
COPY --from=builder --chown=opsbutler:opsbutler /app/ops-butler-core /app/

# Set working directory
WORKDIR /app

# Switch to non-root user
USER opsbutler

# Expose port
EXPOSE 8080

# Set entrypoint
ENTRYPOINT ["/app/ops-butler-core"]