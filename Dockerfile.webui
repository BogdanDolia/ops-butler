FROM golang:1.21-alpine AS builder

# Set working directory
WORKDIR /app

# Copy go.mod and go.sum
COPY go.mod go.sum ./

# Install build dependencies for CGO
RUN apk add --no-cache gcc musl-dev

# Download dependencies
RUN go mod download

# Copy source code
COPY . .

# Build the application
RUN CGO_ENABLED=1 GOOS=linux go build -a -o ops-butler-webui ./cmd/webui

# Create final image
FROM alpine:3.18

# Install required packages
RUN apk add --no-cache ca-certificates sqlite

# Create a non-root user
RUN addgroup -g 1000 opsbutler && \
    adduser -u 1000 -G opsbutler -s /bin/sh -D opsbutler

# Create directories
RUN mkdir -p /app /data /app/public && \
    chown -R opsbutler:opsbutler /app /data

# Copy the binary from builder
COPY --from=builder --chown=opsbutler:opsbutler /app/ops-butler-webui /app/

# Copy static files for the web UI
COPY --chown=opsbutler:opsbutler public/ /app/public/

# Set working directory
WORKDIR /app

# Switch to non-root user
USER opsbutler

# Expose port
EXPOSE 8080

# Set entrypoint
ENTRYPOINT ["/app/ops-butler-webui"]