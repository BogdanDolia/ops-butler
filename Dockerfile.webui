FROM golang:1.21 AS builder

# Set working directory
WORKDIR /app

# Copy go.mod and go.sum
COPY go.mod go.sum ./

# Download dependencies
RUN go mod download

# Copy source code
COPY . .

# Build the application with static linking to avoid GLIBC version issues
RUN CGO_ENABLED=0 GOOS=linux go build -a -ldflags='-extldflags "-static"' -o ops-butler-webui ./cmd/webui

# Create final image
FROM debian:bullseye-slim

# Install required packages
RUN apt-get update && apt-get install -y --no-install-recommends ca-certificates sqlite3 && rm -rf /var/lib/apt/lists/*

# Create a non-root user
RUN groupadd -g 1000 opsbutler && \
    useradd -u 1000 -g opsbutler -s /bin/bash -m opsbutler

# Create directories
RUN mkdir -p /app /data /app/public && \
    chown -R opsbutler:opsbutler /app /data

# Copy the binary from builder
COPY --from=builder --chown=opsbutler:opsbutler /app/ops-butler-webui /app/

# Copy static files for the web UI
COPY --chown=opsbutler:opsbutler public/ /app/public/

# Set working directory
WORKDIR /app

# Switch to non-root user
USER opsbutler

# Expose port
EXPOSE 8080

# Set entrypoint
ENTRYPOINT ["/app/ops-butler-webui"]